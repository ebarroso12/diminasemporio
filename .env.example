# Login do painel em /admin. Sem ADMIN_PASSWORD o painel fica bloqueado — não existe senha padrão.
# ADMIN_EMAIL é opcional: se estiver em branco, só a senha é cobrada.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: chave usada para assinar o cookie de sessão.
# Se ficar em branco, a própria ADMIN_PASSWORD é usada.
ADMIN_SECRET=

# Supabase — enquanto estiver em branco o site mostra o cardápio de lib/seed.ts
# e o painel entra em modo somente leitura.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
