# Supabase — injetado automaticamente pela integração do Marketplace da Vercel.
# Localmente: `vercel env pull` grava tudo em .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta com o Postgres — usada só pelos scripts de schema.
POSTGRES_URL_NON_POOLING=
